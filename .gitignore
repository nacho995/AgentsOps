# Monorepo root .gitignore
# Scope: global patterns shared across all workspaces (frontend/, backend/, etc.).
# Workspace-specific ignores (e.g. Angular cache) live in each workspace's own .gitignore
# (see frontend/.gitignore).

# Dependencies (any workspace, any depth)
node_modules/

# Build outputs
dist/
build/
out-tsc/

# Angular cache (root-level fallback; frontend/ has its own entry too)
.angular/cache/

# Python (backend/)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Local SQLite database + secrets
*.db
.env

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor temp files
*.swp
*.swo
*~
.idea/
